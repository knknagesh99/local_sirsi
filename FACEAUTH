// ==UserScript==
// @name         Auto FaceAuth Sender (Manual Button Trigger)
// @version      1.2
// @description  Manually send FaceAuth data and enable Proceed after success
// @match        https://sarathi.parivahan.gov.in/sarathiservice/authenticationaction.do*
// @run-at       document-end
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    window.addEventListener('load', () => {

        // Create custom FaceAuth button
        const btn = document.createElement('button');

        btn.innerText = '🚀 Send FaceAuth Data';
        btn.type = 'button';

        Object.assign(btn.style, {
            position: 'fixed',
            bottom: '10px',
            right: '200px',
            padding: '10px 16px',
            background: '#00cc66',
            color: 'white',
            fontWeight: 'bold',
            border: '2px solid #006633',
            borderRadius: '8px',
            cursor: 'pointer',
            zIndex: '99999'
        });

        btn.title = 'Click to send FaceAuth data';
        document.body.appendChild(btn);

        // Display server response
        function showResponse(data, isError = false) {
            let box = document.getElementById('customResponseBox');

            if (!box) {
                box = document.createElement('pre');
                box.id = 'customResponseBox';

                Object.assign(box.style, {
                    position: 'fixed',
                    bottom: '70px',
                    right: '20px',
                    maxHeight: '300px',
                    maxWidth: '400px',
                    overflow: 'auto',
                    background: '#111',
                    color: '#0f0',
                    padding: '10px',
                    zIndex: '99999',
                    border: '2px solid #0f0',
                    whiteSpace: 'pre-wrap'
                });

                document.body.appendChild(box);
            }

            box.style.color = isError ? '#ff5555' : '#0f0';
            box.style.borderColor = isError ? '#ff5555' : '#0f0';
            box.textContent = typeof data === 'string'
                ? data
                : JSON.stringify(data, null, 2);
        }

        // Send FaceAuth data on button click
        btn.addEventListener('click', async () => {

            if (btn.disabled) return;

            console.log('🔄 Starting FaceAuth request...');

            const applno =
                document.getElementById('llappln')?.value?.trim() || '';

            const rtocode =
                document.getElementById('rtocode')?.value?.trim() || '';

            const capPho = window.applimg;

            // Validate required fields
            if (!applno || !rtocode || !capPho) {
                alert(
                    '❌ Required data missing. Please check application number, RTO code, and image data.'
                );

                console.error({
                    applno,
                    rtocode,
                    capPhoAvailable: Boolean(capPho)
                });

                return;
            }

            const originalText = btn.innerText;

            btn.disabled = true;
            btn.innerText = '⏳ Sending...';
            btn.style.opacity = '0.7';

            try {
                // Run the page's original status function first,
                // if available.
                if (typeof window.faceAuthStatus === 'function') {
                    await window.faceAuthStatus();
                    console.log('✅ faceAuthStatus completed');
                }

                const data = new URLSearchParams();

                data.append('applno', applno);
                data.append('rtocode', rtocode);
                data.append('faceres', '1');
                data.append('CapPho', capPho);

                const response = await fetch(
                    '/sarathiservice/saveFaceAuthData.do',
                    {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type':
                                'application/x-www-form-urlencoded; charset=UTF-8',
                            'Accept': 'application/json, text/plain, */*'
                        },
                        body: data.toString()
                    }
                );

                // Check HTTP status
                const responseText = await response.text();

                if (!response.ok) {
                    throw new Error(
                        `HTTP ${response.status}: ${responseText}`
                    );
                }

                // Parse JSON response
                let json;

                try {
                    json = JSON.parse(responseText);
                } catch {
                    throw new Error(
                        'Server returned a non-JSON response: ' +
                        responseText.slice(0, 300)
                    );
                }

                console.log('✅ Server response:', json);
                showResponse(json);

                // Enable Proceed only after HTTP and JSON success.
                // Verify the JSON's application-level success status
                // separately if the server provides one.
                const proceedBtn =
                    document.getElementById('capphto1');

                if (proceedBtn) {
                    proceedBtn.disabled = false;
                    proceedBtn.removeAttribute('disabled');

                    console.log('✅ Proceed button enabled');
                } else {
                    console.warn(
                        'Proceed button #capphto1 was not found.'
                    );
                }

                btn.innerText = '✅ FaceAuth Sent';
                btn.style.background = '#198754';

                alert('✅ FaceAuth request sent successfully!');

            } catch (err) {
                console.error('❌ FaceAuth request failed:', err);

                showResponse(
                    'FaceAuth request failed:\n' + err.message,
                    true
                );

                alert(
                    '❌ FaceAuth request failed. Check the response box and console.'
                );

                // Allow retry
                btn.disabled = false;
                btn.innerText = originalText;
                btn.style.background = '#00cc66';
                btn.style.opacity = '1';
            }
        });

    });
})();
